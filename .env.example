# Every value here is optional. The site builds and runs with this file absent
# and with an entirely empty .env.

# Absolute origin used for canonical URLs, sitemap and OpenGraph image resolution.
# Falls back to the value in src/data/seo.ts when unset.
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key, from https://web3forms.com — it identifies a mailbox and
# authorises nothing, so it is safe in the client bundle. With it absent the
# contact form renders a "not configured" notice instead of failing to submit.
NEXT_PUBLIC_WEB3FORMS_KEY=
